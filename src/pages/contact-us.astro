---
import Base from '../layouts/Base.astro';
import Form from '../components/forms/Form.astro';
import Icon from '../components/Icon.astro';
import { contactForm } from '../lib/forms';
import { site } from '../data/site';
---
<Base
  title="Contact Us | B Keim Rewind Marketing"
  description={`Contact B Keim Rewind Marketing in ${site.location}. Send a message or email ${site.email}.`}
>
  <section class="contact" aria-labelledby="contact-title">
    <div class="contact__intro bg-pine on-dark">
      <div class="contact__intro-inner">
        <p class="eyebrow">Contact us</p>
        <h1 id="contact-title">Let's <em>talk.</em></h1>
        <p class="lede todo">TODO: one or two sentences inviting people to reach out, and expected response time.</p>
        <ul class="contact__details" role="list">
          <li><Icon name="mail" /><a href={site.emailHref}>{site.email}</a></li>
          {site.phone && <li><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></li>}
          <li><span class="mono">{site.location}</span></li>
        </ul>
      </div>
    </div>

    <div class="contact__form">
      <div class="contact__form-inner">
        <h2 class="visually-hidden">Send a message</h2>
        <Form
          form={contactForm}
          submitLabel="Send message"
          successTitle="Message sent"
          successText="Thanks for reaching out. We will get back to you soon."
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
  }
  .contact__intro,
  .contact__form {
    padding: clamp(2.5rem, 1.5rem + 5vw, 6rem) var(--gutter);
  }
  .contact__intro-inner,
  .contact__form-inner {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: 34rem;
  }
  .contact__intro h1 {
    font-size: var(--step-4);
  }
  .contact__intro h1 em {
    color: var(--blush);
  }
  .contact__intro .lede {
    opacity: 0.88;
  }
  .contact__details {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .contact__details li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .contact__details svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--sage);
  }
  .contact__details a {
    font-weight: 600;
    text-decoration: none;
  }
  .contact__details a:hover {
    color: var(--blush);
  }
  .contact__form {
    background: var(--paper);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: 5fr 7fr;
    }
    .contact__intro {
      display: flex;
      justify-content: flex-end;
    }
    .contact__intro-inner {
      align-content: start;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
