---
interface Props {
  name: 'arrow-down-right' | 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'facebook' | 'instagram' | 'linkedin' | 'phone' | 'mail' | 'pause' | 'play' | 'blueprint' | 'compass' | 'hard-hat';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {name === 'arrow-down-right' && <path d="M6 6l12 12M18 8v10H8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" />}
  {name === 'arrow-up-right' && <path d="M6 18L18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" />}
  {name === 'arrow-right' && <path d="M3 12h17M14 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />}
  {name === 'arrow-left' && <path d="M21 12H4M10 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />}
  {name === 'facebook' && <path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H7.8v3h2.6V21h3.1z" />}
  {name === 'instagram' && <g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" /></g>}
  {name === 'linkedin' && <path fill="currentColor" d="M4.5 9h3.2v10.5H4.5V9zm1.6-5.1a1.85 1.85 0 110 3.7 1.85 1.85 0 010-3.7zM9.7 9h3.1v1.4h.04c.43-.8 1.5-1.65 3.06-1.65 3.27 0 3.87 2.15 3.87 4.95v5.8h-3.2v-5.15c0-1.23-.02-2.8-1.71-2.8-1.71 0-1.97 1.33-1.97 2.71v5.24H9.7V9z" />}
  {name === 'phone' && <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" />}
  {name === 'mail' && <g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" /><path d="M3 6l9 7 9-7" /></g>}
  {name === 'pause' && <path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />}
  {name === 'play' && <path fill="currentColor" d="M8 5v14l11-7z" />}
  {name === 'blueprint' && <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><rect x="3" y="4" width="18" height="16" /><path d="M3 12h7v8M10 4v4M14 12h7M14 12v3" /></g>}
  {name === 'compass' && <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><circle cx="12" cy="6" r="2" /><path d="M12 2.5V4M11 7.8L6 20M13 7.8L18 20M7.6 15.5h8.8" /></g>}
  {name === 'hard-hat' && <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M2.5 17.5h19v2.5h-19zM4.5 17.5a7.5 7.5 0 0115 0" /><path d="M10 10.5V6.5h4v4" /></g>}
</svg>
