---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, cta, site, socials } from '../data/site';
const year = new Date().getFullYear();
const liveSocials = socials.filter((s) => s.href);
---
<footer class="site-footer on-dark">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo tone="light" />
      <p class="site-footer__tag todo">TODO: one-line brand tagline.</p>
    </div>

    <nav aria-label="Footer">
      <p class="site-footer__label">Explore</p>
      <ul role="list">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={cta.href}>{cta.label}</a></li>
      </ul>
    </nav>

    <div>
      <p class="site-footer__label">Get in touch</p>
      <ul role="list">
        <li><a href={site.emailHref}>{site.email}</a></li>
        {site.phone ? <li><a href={site.phoneHref}>{site.phone}</a></li> : <li class="todo">TODO: phone</li>}
        <li>{site.location}</li>
      </ul>
      {liveSocials.length > 0 && (
        <ul class="site-footer__social" role="list">
          {liveSocials.map((s) => (
            <li><a href={s.href} aria-label={s.label} rel="noopener"><Icon name={s.icon} /></a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <div class="container site-footer__legal">
    <p>&copy; {year} B Keim Rewind LLC</p>
    <p class="mono">Covington, LA</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--pine-deep);
    color: var(--bone);
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .site-footer__tag {
    max-width: 22rem;
    opacity: 0.8;
  }

  .site-footer__label {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .site-footer ul {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
    opacity: 0.85;
  }

  .site-footer a:hover {
    opacity: 1;
    color: var(--blush);
  }

  .site-footer__social {
    display: flex !important;
    gap: 0.75rem !important;
    margin-top: 1rem;
  }

  .site-footer__social svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line-inverse);
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
