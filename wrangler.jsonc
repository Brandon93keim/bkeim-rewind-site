{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bkeim-rewind-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Serve on the default *.workers.dev URL only. No custom domain or route until bkrewind.com
  // moves off Wix (do not add "routes" here yet).
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Non-secret config. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are set with
  // `npx wrangler secret put <NAME>` and never committed. Local overrides go in .dev.vars.
  "vars": {
    // Comma-separated; every submission goes out as one email with all of them in "to".
    // Must be the Resend account email while CONTACT_FROM is onboarding@resend.dev.
    "CONTACT_TO": "Brandon@bkrewind.com",
    // Resend's shared test sender. It only delivers to the Resend account's own address, so
    // CONTACT_TO must stay Brandon@bkrewind.com while this is set. TODO: once bkrewind.com is verified
    // in Resend, switch to "B Keim Rewind Website <website@bkrewind.com>" and add more recipients.
    "CONTACT_FROM": "B Keim Rewind Website <onboarding@resend.dev>",
    // "true" sends through Resend; RESEND_API_KEY and TURNSTILE_SECRET_KEY must then be set.
    "EMAIL_ENABLED": "true"
  }
}
